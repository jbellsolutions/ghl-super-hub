# Private Integration Token or OAuth access token. Never commit real credentials.
# Location token: sub-account Settings > Private Integrations > Create New.
GHL_API_KEY=
GHL_LOCATION_ID=
# For separate tenants: ./ghl --env-file /secure/client-a.env ...
# Internal API session credentials are deliberately not part of the default setup.
# Optional MCP browser access is configured separately in Hermes (docs/INSTALL.md).
